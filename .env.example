# Required. DeepSeek API key, used only on the server.
DEEPSEEK_API_KEY=

# Optional. Defaults to deepseek-flash.
DEEPSEEK_MODEL=deepseek-flash

# Optional but recommended. A fine-grained GitHub token with "Public repositories (read-only)"
# access and no permissions. Raises the GitHub API limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=

# Optional. When set, visitors must enter this code before the site calls the AI.
ACCESS_CODE=
