  "narrative": {
    "northStar": "The Marked Exercise Book",
    "overview": "Every question is pinned to the student's own lines the way a teacher's red pen marks an exercise book, set like a reference edition: code and conversation as twin columns around a centre rail of keys. Cool paper white, iron ink, one red pen, one ballpoint blue, pale rule-blue hairlines. 1px rules, square detents, no radius, no shadows.",
    "keyCharacteristics": [
      "Red pen = mentor only; ballpoint blue = student only",
      "Ink-filled primary actions, ruled text for everything else",
      "Marks are shapes (tick, half tick, cross, dash, brackets, circled refs), never colour alone",
      "Zero radius; the circled reference number is the only circle",
      "Flat: rules and tone instead of shadows"
    ],
    "rules": [
      {
        "name": "The Two Pens Rule",
        "body": "Red appears only where the mentor wrote or marked; blue only where the student wrote or chose. Code syntax, charts of student data, tags and buttons never borrow either.",
        "section": "colors"
      },
      {
        "name": "The Ink Primary Rule",
        "body": "The one primary action per view is a solid ink rectangle with paper text. Red is never a button fill.",
        "section": "colors"
      },
      {
        "name": "The No-Gradient Rule",
        "body": "Flat fills only; the only translucency is the two washes.",
        "section": "colors"
      },
      {
        "name": "The Hand Rule",
        "body": "Kai is for mentor words only; the student's words are always sans in blue.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Numbers in gutters, keys, counts and scores use tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Flat Page Rule",
        "body": "Do not add shadows, glows, blur or lift on hover. Separate with a 1px rule or a tone.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do write mentor words in Kai red and student words in sans blue; nothing else uses those colours.",
      "Do use ink-filled rectangles for the primary action and underlined text for the rest.",
      "Do separate with 1px rules, set small numbers in tabular Source Serif or sans, and pair every mark with a label.",
      "Do keep corners at 0 and add new detents as squares."
    ],
    "donts": [
      "Don't use chat bubbles, avatars, or an editor-beside-chat layout; turns are label then text.",
      "Don't reintroduce cream, tangerine, rounded pills, soft shadows, glass, gradients, or emoji icons.",
      "Don't use the three-up icon-card grid, big-number stat tiles, hero gradients, or eyebrow kickers above headings.",
      "Don't use red for buttons, success/warning semantics, or syntax colours; don't use blue for links or decoration.",
      "Don't colour code tokens; weight and two greys carry structure.",
      "Don't encode meaning in colour alone."
    ]
  }
}